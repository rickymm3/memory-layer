DATABASE_URL=postgresql://memory:memory_dev_password@localhost:5432/memory_layer_development

# ── Hosted public site (app_main.py / make site) ─────────────────────────────
# Required for the public site. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# FLASK_SECRET_KEY=

# ── LLM provider selection ────────────────────────────────────────────────────
# CHAT_PROVIDER controls which backend handles chat, extraction, and reconciliation.
# EMBEDDING_PROVIDER controls which backend generates embeddings (Anthropic excluded).
#
# Auto-detection order: anthropic → openai → openai_compat → ollama
# Override by setting CHAT_PROVIDER and/or EMBEDDING_PROVIDER explicitly.
#
# Option A — Anthropic Claude (recommended — chat) + Ollama (embeddings, required):
ANTHROPIC_API_KEY=sk-ant-...
CHAT_MODEL=claude-haiku-4-5-20251001
EMBEDDING_MODEL=qwen3-embedding:latest
OLLAMA_HOST=http://localhost:11434
#
# Option B — Ollama only (no API keys needed):
# CHAT_PROVIDER=ollama
# EMBEDDING_PROVIDER=ollama
# CHAT_MODEL=qwen3:8b
# EMBEDDING_MODEL=qwen3-embedding:latest
#
# Option C — OpenAI API (chat + embeddings):
# CHAT_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# EMBEDDING_PROVIDER=openai
# CHAT_MODEL=gpt-4o
# EMBEDDING_MODEL=text-embedding-3-small
#
# Option D — Local OpenAI-compatible server (LM Studio, llama.cpp, Jan, etc.):
# CHAT_PROVIDER=openai_compat
# OPENAI_COMPAT_BASE_URL=http://localhost:1234
# OPENAI_COMPAT_API_KEY=none    # leave as "none" for local servers
# EMBEDDING_PROVIDER=openai_compat

# ⚠️  Embedding model consistency: once you store atoms with one embedding model,
# do NOT change EMBEDDING_MODEL without wiping and re-embedding all atoms.
# Mixing models produces dimension mismatches or silent similarity corruption.

# Minimum cosine similarity (0–1) for retrieved memories. Below this threshold
# memories are not injected into the prompt. Default 0.60.
# MEMORY_RETRIEVAL_THRESHOLD=0.60

# Model scope for automatic lesson injection in the UserPromptSubmit hook.
# The hook always injects active atoms from this scope as "Model adaptation directives".
# Set to the model ID you're using. Default: model:claude-sonnet-4-6
# MEMORY_MODEL_SCOPE=model:claude-sonnet-4-6

# ── Web research fallback ─────────────────────────────────────────────────────
# Off by default. Set WEB_RESEARCH_ENABLED=true to enable.
# If enabled, research is triggered when the user asks to search/check/look up
# something, or when local memories are sparse.
#
# Guardrails:
#   - Raw web results are never auto-stored as memory atoms.
#   - Messages containing secrets/passwords/tokens are never sent externally.
#   - Set WEB_RESEARCH_ENABLED=false (or omit) to disable completely.
#
# WEB_RESEARCH_ENABLED=false
# WEB_SEARCH_PROVIDER=none        # options: none, brave, tavily  (more planned)
# WEB_SEARCH_API_KEY=             # required when provider != none
